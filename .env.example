# BOTAIRDROP Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Solana Network Configuration
# ============================================
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ============================================
# Proxy Configuration
# ============================================
PROXY_PROVIDER=luminati
PROXY_API_KEY=your-proxy-api-key

# ============================================
# CAPTCHA Configuration
# ============================================
CAPTCHA_PROVIDER=2captcha
CAPTCHA_API_KEY=your-captcha-api-key

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_FILE=logs/botairdrop.log

# ============================================
# Performance Configuration
# ============================================
MAX_CONCURRENT_TASKS=10
MAX_RETRIES=3
RETRY_DELAY=1000

# ============================================
# Security Configuration
# ============================================
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# ============================================
# Jito Configuration
# ============================================
JITO_RPC_URL=https://jito-rpc.com
JITO_API_KEY=your-jito-api-key

# ============================================
# Database Configuration (Optional)
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/botairdrop
REDIS_URL=redis://localhost:6379

# ============================================
# Monitoring Configuration (Optional)
# ============================================
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3000
